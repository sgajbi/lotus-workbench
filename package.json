    "start": "next start",
    "lint": "npm run quality:branch-protection && npm run quality:runtime-support && npm run quality:runtime-state && npm run quality:bff-header-boundary && npm run quality:feature-transport && npm run quality:source-authority && npm run quality:dependency-risk && npm run quality:font-assets && npm run quality:product-copy && npm run quality:e2e-scenarios && npm run lint:css-global && npm run lint:risk-architecture && npm run quality:screen-docs && npm run lint:react-compiler && npm run lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:css-global": "node scripts/quality/check-css-global-governance.mjs",
