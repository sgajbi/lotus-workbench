    "quality:font-assets": "node scripts/quality/check-font-asset-governance.mjs",
    "quality:product-copy": "node scripts/quality/check-product-copy-governance.mjs --max=227 --max-unresolved=1702 --unresolved-digest=6654a36558a1a8b938f5a2d4e3433926fc5bf3c8060548c984df149fbbaff708",
    "quality:e2e-scenarios": "node scripts/quality/check-e2e-scenario-governance.mjs",
