# Keep the production build context explicit. Local environment files, generated
# evidence, test assets, documentation, caches, and logs must never enter it.
*
!package.json
!package-lock.json
!tools/
tools/*
!tools/eslint-plugin-next/
tools/eslint-plugin-next/*
!tools/eslint-plugin-next/package.json
!tools/eslint-plugin-next/LICENSE
!tools/eslint-plugin-next/README.md
!tools/eslint-plugin-next/UPSTREAM-PROVENANCE.json
!tools/eslint-plugin-next/dist/
!tools/eslint-plugin-next/dist/**
!next-env.d.ts
!next.config.mjs
!tsconfig.json
!src/
!src/**
!scripts/
scripts/*
!scripts/config/
scripts/config/*
!scripts/config/next-artifact-layout.mjs
!scripts/runtime/
scripts/runtime/*
!scripts/runtime/workbench-healthcheck.mjs
!scripts/quality/
scripts/quality/*
!scripts/quality/clean-next-build-artifacts.mjs
!scripts/quality/check-portfolio-record-bundles.mjs
