FROM nginx:1.30.3-alpine3.23-slim@sha256:d5b51cfc7d55fc7a7bcf4d1d577b9c3738331df56d68f0b1d8ac9795b9470a5a

# CVE-2026-14456 remediation from #873, refreshed under #897.
# Remove the OpenSSL pins once the pinned base carries libcrypto3/libssl3 >=3.5.9-r0.
# PCRE2 remediation under #1110: CVE-2026-103111, CVE-2026-86145, CVE-2026-89157, CVE-2026-89161.
# Alpine v3.23 package commit d3daff575f2cf4da02cba798b41436b60d843444 supplies 10.49-r0.
# Remove the PCRE2 pin once the pinned base carries pcre2 >=10.49-r0.
# Remove this RUN only after both independent retirement conditions are satisfied.
# When Alpine supersedes these exact packages the build fails by design; refresh them through an issue.
RUN apk add --no-cache --upgrade \
    "libcrypto3=3.5.9-r0" \
    "libssl3=3.5.9-r0" \
    "pcre2=10.49-r0"

USER 101:101
